# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- identity ---------------------------------------------------------------
APP_NAME="Private LLM Gateway"
ENVIRONMENT=production

# --- database (PostgreSQL from day one) -------------------------------------
DATABASE_URL=postgresql+asyncpg://gateway:CHANGE_ME@postgres:5432/gateway
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- shared state (required for more than one instance) ---------------------
# Empty = in-memory, single instance only.
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=gw

# --- secrets ----------------------------------------------------------------
# Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty on first run and one is generated into data/master.key.
MASTER_KEY=
# Signs admin session cookies. Leave empty and one is generated into data/session.secret.
SESSION_SECRET=

# --- first run --------------------------------------------------------------
# The owner account is created on first boot. Leave the password empty and a
# random one is written to data/first-run.txt.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=
SEED_DEMO_DATA=true

# --- security ---------------------------------------------------------------
# Comma separated. Empty = any IP. Prefer doing this at the reverse proxy.
ADMIN_ALLOWED_IPS=
# Only enable behind a proxy you control that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=true
# Must be true in production (HTTPS only).
COOKIE_SECURE=true
SESSION_HOURS=8
SESSION_ABSOLUTE_HOURS=168
# /v1 has no browser CORS by default. Only add origins if a browser must call it.
CORS_ORIGINS=
# Shared secret for /metrics. Empty = loopback only.
METRICS_TOKEN=

# --- public site (HOMEPAGE_SPEC) --------------------------------------------
# Absolute URL used in code samples and the sitemap. Empty = request origin.
PUBLIC_BASE_URL=
SUPPORT_EMAIL=support@example.com
PRODUCT_TAGLINE="One API for fast, reliable AI models."
# Show model prices on the public pages.
PUBLIC_PRICING=false
# Status page link in the header/footer. Empty = hidden.
STATUS_PAGE_URL=
# Set true once you have replaced the placeholder legal pages with reviewed text.
LEGAL_REVIEWED=false

# --- limits -----------------------------------------------------------------
GLOBAL_MONTHLY_CAP_USD=50
MAX_REQUEST_BYTES=1000000
MAX_TOKENS_CEILING=32000
MAX_ATTEMPTS=3
REQUEST_TIMEOUT_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=45
CONCURRENCY_SLOT_TTL=120

# --- behaviour --------------------------------------------------------------
# off | metadata | full
LOG_PROMPTS=metadata
# json | text
LOG_FORMAT=json
RETENTION_DAYS=30
IDEMPOTENCY_TTL_SECONDS=86400
